{
  "name": "arena-games-backend",
  "version": "1.0.0",
  "main": "server.js",
  "scripts": {
    "build": "node scripts/ensure-build.js --force",
    "typecheck": "tsc -p . --noEmit",
    "prestart": "node scripts/ensure-build.js",
    "start": "node server.js",
    "dev": "npm run build && node --watch server.js",
    "pretest": "npm run build",
    "test": "node --test --test-timeout=60000 lib/*.test.js \"dist/**/*.test.js\"",
    "smoke": "npm run build && node scripts/smoke/run.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.101.1",
    "@types/express": "^4.17.25",
    "@types/node": "^22.20.5",
    "cors": "^2.8.5",
    "dotenv": "^17.4.0",
    "ethers": "^6.13.0",
    "express": "^4.18.2",
    "express-rate-limit": "^8.3.2",
    "typescript": "^5.9.3",
    "web-push": "^3.6.7"
  },
  "overrides": {
    "qs": "^6.17.1"
  }
}
