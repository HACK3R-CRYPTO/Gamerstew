# GameArena backend settings. Generated from src/platform/env.ts: edit that file, then run
#   npm run env:example
# A line that is commented out shows the default the server uses when it is not set.

# ── Server ──────────────────────────────────────────────────────
# Port to listen on. The platform sets this.
# PORT=3005
# Comma-separated browser origins allowed to call the API. REQUIRED.
ALLOWED_ORIGINS=
# Shared with the frontend server. The server refuses to start without it. REQUIRED. SECRET: never commit a real value.
INTERNAL_SECRET=
# A request slower than this is logged.
# SLOW_REQUEST_MS=1500
# A request with no reply after this long is answered 504.
# REQUEST_TIMEOUT_MS=30000
# How long requests in flight get to finish on a redeploy.
# SHUTDOWN_GRACE_MS=10000
# Deadline for every database call.
# DB_TIMEOUT_MS=12000
# Public site address, used in notification links.
# GAMEARENA_APP_URL=https://gamearenahq.xyz
# ── Data ────────────────────────────────────────────────────────
# Supabase project URL. REQUIRED.
SUPABASE_URL=
# Supabase API key. REQUIRED. SECRET: never commit a real value.
SUPABASE_ANON_KEY=
# Goldsky subgraph endpoint. Defaults to the public one.
SUBGRAPH_URL=
# ── Chain ───────────────────────────────────────────────────────
# Celo RPC endpoint.
# CELO_RPC_URL=https://forno.celo.org
# Older name for CELO_RPC_URL, still read by one module.
# CELO_RPC=https://forno.celo.org
# Signs score vouchers and resolves wagers. Without it scores cannot be signed. SECRET: never commit a real value.
VALIDATOR_PRIVATE_KEY=
# Gas-drip wallet. Falls back to the validator key. SECRET: never commit a real value.
FAUCET_PRIVATE_KEY=
# Relays arena purchases. Falls back to the validator key. SECRET: never commit a real value.
ARENA_RELAYER_KEY=
# Writes MARKOV match feedback on-chain. SECRET: never commit a real value.
FEEDBACK_ORACLE_KEY=
# GamePass contract.
# GAME_PASS_ADDRESS=0xBB044d6780885A4cDb7E6F40FCc92FF7b051DAdE
# SoloWager contract. Unset turns wagers off.
SOLO_WAGER_ADDRESS=
# Habitat registry contract.
HABITAT_REGISTRY_ADDRESS=
# DuelEscrow contract. Unset turns duel rooms off.
DUEL_ESCROW_ADDRESS=
# PerkShop contract.
# PERK_SHOP_ADDRESS=0xe451Ab21587e6Fd540522495CbaE62dD0f207Ef5
# G$ token contract.
# G_TOKEN_ADDR=0x62B8B11039FcfE5aB0C56E502b1C372A3d2a9c7A
# Warn when the signer holds less CELO than this.
# SIGNER_MIN_CELO=5
# ── Anti-cheat ──────────────────────────────────────────────────
# Games whose score is cut to what the run log supports. "none" switches it off.
# SCORE_ENFORCE=stack,simon
# ── Gasless ─────────────────────────────────────────────────────
# Backend pays gas for skill-game scores. On unless set to "false".
# GASLESS_SKILL_GAMES=true
# Gasless saves one wallet may make per day.
# GASLESS_MAX_PER_WALLET_DAY=60
# Gasless saves across all wallets per day.
# GASLESS_MAX_GLOBAL_DAY=3000
# ── Faucet ──────────────────────────────────────────────────────
# CELO sent to a fresh wallet.
# FAUCET_DRIP_CELO=0.7
# CELO sent on a partner request.
# FAUCET_PARTNER_DRIP_CELO=0.1
# A wallet below this balance counts as fresh.
# FAUCET_FRESH_THRESHOLD_CELO=0.05
# Drips per day, all wallets.
# FAUCET_MAX_PER_DAY=50
# Drips per day from one address.
# FAUCET_MAX_PER_IP_DAY=5
# Only verified humans may use the faucet.
# FAUCET_REQUIRE_GOODDOLLAR=false
# ── Notifications ───────────────────────────────────────────────
# Web-push public key. Unset turns push off.
VAPID_PUBLIC_KEY=
# Web-push private key. SECRET: never commit a real value.
VAPID_PRIVATE_KEY=
# Contact address sent with pushes.
# VAPID_CONTACT_EMAIL=mailto:notify@gamearenahq.xyz
# ── Arena ───────────────────────────────────────────────────────
# Free MARKOV matches per player per day.
# ARENA_FREE_MATCHES_PER_DAY=10
# Wallet that holds the weekly arena pool.
ARENA_POOL_WALLET=
# Weekly arena pool in G$.
# ARENA_WEEKLY_POOL_GS=500
# Scoped key for the agent-play partner. Unset closes those routes. SECRET: never commit a real value.
AGENT_PLAY_KEY=
# Least time between on-chain feedback writes.
# FEEDBACK_MIN_INTERVAL_MS=600000
# ── Events ──────────────────────────────────────────────────────
# Arena Cup start.
# CUP_STARTS_AT=2026-08-07T16:00:00Z
# Arena Cup end.
# CUP_ENDS_AT=2026-08-21T16:00:00Z
# Most points a player may spend in the Cup.
# CUP_MAX_SPEND_PTS=60
# Private sprint start.
# SPRINT_STARTS_AT=2026-09-01T00:00:00Z
# Private sprint end.
# SPRINT_ENDS_AT=2026-09-06T21:00:00Z
# Sprint prize pool in G$.
# SPRINT_POOL_G=430000
# How many sprint places pay.
# SPRINT_WINNERS=10
# Creator contest start. Unset means no contest.
CREATOR_CONTEST_START=
# Creator contest end.
CREATOR_CONTEST_END=
# Tug of War event id.
# TUG_EVENT_ID=tug-1
# Tug of War start.
# TUG_STARTS_AT=2026-09-23T17:00:00Z
# Tug of War end.
# TUG_ENDS_AT=2026-09-30T17:00:00Z
# Tug of War prize in G$.
# TUG_PRIZE_G=1000000
# Tug of War bounty per slot in G$.
# TUG_BOUNTY_G=2500
# Tug of War bounty slots.
# TUG_BOUNTY_SLOTS=160
# Tug of War referral prizes in G$, best first.
# TUG_REFERRAL_PRIZES_G=500000,300000,200000
# Full-value pulls per player per day.
# TUG_DAILY_PULL_CAP=10
# Value of a pull past the daily cap.
# TUG_OVER_CAP_RATE=0.12
# Points a verified human adds.
# TUG_POINTS_PER_HUMAN=20
# Games needed to qualify.
# TUG_QUALIFY_GAMES=3
# On-chain game types that count.
# TUG_GAME_TYPES=0,1,2
# How long Tug standings are cached.
# TUG_TTL_MS=30000
# ── Partners ────────────────────────────────────────────────────
# Partners as slug or slug:gameType:label, comma-separated. Each needs a PARTNER_KEY_<SLUG>.
PARTNER_GAMES=
# Vatar games API.
# VATAR_API=https://lagoslife.app/api/games/v1
# Vatar API secret. SECRET: never commit a real value.
VATAR_SECRET=
# Checks the signature on Vatar webhooks. SECRET: never commit a real value.
VATAR_WEBHOOK_SECRET=
# ── Partners (one per id in PARTNER_GAMES) ──
# PARTNER_KEY_<ID>=
