# MARKOV-1 agent — Railway service env vars.

# Agent wallet on Celo Mainnet. Holds CELO for gas + G$ for wagers.
PRIVATE_KEY=

# Celo RPC. Forno is fine for hobby load; swap to a paid endpoint
# (Alchemy / Quicknode) if you start seeing 429s under bursts.
VITE_RPC_URL=https://forno.celo.org
VITE_ARENA_PLATFORM_ADDRESS=0x5C0eafE7834Bd317D998A058A71092eEBc2DedeE

# Supabase — same project + same anon key as the games-backend service.
# Works because RLS is disabled on agent_* tables. If you ever enable RLS,
# swap to SUPABASE_SERVICE_ROLE_KEY or add anon policies for those tables.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Loss-cap circuit breaker. Both in G$ (parseEther'd at boot).
GLOBAL_DAILY_LOSS_CAP=100
WALLET_DAILY_LOSS_CAP=50

# Optional — Moltbook social posts. Leave blank to skip.
MOLTBOOK_API_KEY=
